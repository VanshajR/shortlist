# Postgres with pgvector. Neon in production; for local work, the container in the README.
DATABASE_URL=

# A throwaway database for the tests (they empty its tables). Never point this at real data.
TEST_DATABASE_URL=postgresql://postgres:dev@localhost:5433/shortlist_test

# Models, as provider:model. Chat models are tried in order until one answers.
# Providers: openai, anthropic, groq, gemini, openrouter, ollama, custom (any OpenAI-compatible URL)
SHORTLIST_LLM=groq:openai/gpt-oss-120b,gemini:gemini-2.5-flash
# Embeddings must be 768 numbers: gemini:gemini-embedding-001, openai:text-embedding-3-small, ollama:nomic-embed-text
SHORTLIST_EMBEDDINGS=gemini:gemini-embedding-001

# Keys for whichever providers you use above (Ollama needs none)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# CUSTOM_BASE_URL=https://your-endpoint/v1
# CUSTOM_API_KEY=

# From @BotFather, for the Telegram bot
TELEGRAM_BOT_TOKEN=
