{
  "manifest_version": 3,
  "name": "Shortlist Fill",
  "version": "0.1.0",
  "description": "Fills Workday job applications from your saved details. You review every page and press Submit yourself.",
  "permissions": ["storage", "unlimitedStorage"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "src/background.js" },
  "action": { "default_title": "Fill this Workday page" },
  "options_page": "options.html",
  "commands": {
    "fill": { "suggested_key": { "default": "Alt+Shift+F" }, "description": "Fill this Workday page" }
  },
  "content_scripts": [{
    "matches": ["https://*.myworkdayjobs.com/*", "https://*.myworkdaysite.com/*", "https://*.myworkday.com/*"],
    "js": ["src/match.js", "src/dom.js", "src/fill.js", "src/ui.js"],
    "run_at": "document_idle"
  }],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
